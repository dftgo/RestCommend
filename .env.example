# Shared access key between the app and the local server.
# Any long made-up value (not a provider key). Put the SAME value in both lines.
APP_ACCESS_KEY=
VITE_APP_ACCESS_KEY=

# OpenAI API key (server only — never put it in a VITE_ variable).
OPENAI_API_KEY=

# Optional (defaults are in code):
# RESEARCH_PROVIDER=openai    # openai | demo  (default: openai when OPENAI_API_KEY is set, else demo)
# OPENAI_MODEL=gpt-5.5
# MAX_SEARCH_CALLS=8
# MAX_OUTPUT_TOKENS=12000
# SEARCH_CONTEXT_SIZE=medium  # low | medium | high
# PARALLEL_SEARCHES=1         # parallel OpenAI calls per search (1–3); 2 was measured as not faster
# DEMO_SCENARIO=normal        # demo only: normal | empty | provider_error | invalid_output | slow
# SEARCH_TIMEOUT_MS=90000
# MAX_CANDIDATES=10
# API_PORT=8787
